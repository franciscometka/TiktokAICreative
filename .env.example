# ---------------------------------------------------------------
# TikTok AI Creative Factory — variáveis de ambiente
# Copie para .env.local. NUNCA commite secrets.
# ---------------------------------------------------------------

# Planejamento: "mock" (padrão, sem custo) ou "anthropic" (Claude real, PAGO)
LLM_PROVIDER=mock
# Só com LLM_PROVIDER=mock: atraso artificial (ms) do planejamento simulado, para testar a
# tela de processamento, o polling e a recuperação após restart. 0 = imediato.
MOCK_PLANNER_DELAY_MS=0
# Lida SOMENTE do ambiente, no servidor. Nunca commitar, nunca expor ao browser.
ANTHROPIC_API_KEY=
# Tentativas quando a saída do Claude falha na validação (1 = sem retry; máx. 3)
LLM_MAX_VALIDATION_ATTEMPTS=2
# Retries de transporte do SDK em 429/5xx/conexão (0–2)
LLM_MAX_TRANSPORT_RETRIES=1
# Timeout por chamada ao Claude (ms)
LLM_TIMEOUT_MS=600000

# Persistência local: "file" (padrão; JSON + JSONL em DATA_DIR) ou "memory" (testes)
STORAGE=file
DATA_DIR=data

# Vídeo IA: só existe "mock" (nenhuma chamada paga).
VIDEO_PROVIDER=mock
# Narração: "mock" (padrão; simulada, sem custo) ou "elevenlabs" (TTS real, PAGO, só após aprovação).
AUDIO_PROVIDER=mock
# Lida SOMENTE do ambiente, no servidor. Nunca commitar, nunca expor ao browser.
ELEVENLABS_API_KEY=
# Narrações versionadas: <AUDIO_DIR>/<campanha>/<criativo>/v<N>/{narration.mp3, timing.json, metadata.json}
AUDIO_DIR=outputs/audio
# Timeout de UMA chamada de TTS (ms). Não há retry automático.
TTS_TIMEOUT_MS=60000

# Renderização: "mock" (padrão; não gera arquivo) ou "remotion" (MP4 real, local, sem custo de API).
# Antes do 1º render real: npm run render:setup (baixa o Chrome Headless Shell do Remotion).
RENDERER=mock
# MP4s em <RENDERS_DIR>/<campanha>/<criativo>/v<N>/final.mp4 (+ manifest.json). Nunca sobrescreve.
RENDERS_DIR=outputs/renders
# Abas do Chrome em paralelo no render (1–16). Vazio = padrão do Remotion (metade dos núcleos).
RENDER_CONCURRENCY=
# "true" mostra a descrição técnica da cena nos placeholders de vídeo IA (só desenvolvimento).
RENDER_DEBUG=false
# Windows: se a pasta do projeto for muito funda (caminho > 260 caracteres), o Chrome do Remotion
# não abre (ENOENT). Copie node_modules/.remotion/chrome-headless-shell/... para um caminho curto
# e aponte aqui o chrome-headless-shell.exe. Vazio = o Chrome baixado pelo render:setup.
RENDER_BROWSER_EXECUTABLE=
# Só para empresas com mais de 3 pessoas (Remotion Company License). Lida só no servidor.
REMOTION_LICENSE_KEY=

# Cotação USD -> BRL usada nas estimativas. Vazio = default de src/config/pricing.ts
USD_BRL_EXCHANGE_RATE=

# Limites de orçamento em BRL. Vazio = defaults de src/config/budget.ts
MAX_COST_PER_CREATIVE_BRL=
MAX_COST_PER_CAMPAIGN_BRL=

# Se "true", o usuário PODE autorizar explicitamente exceder o limite.
# Mesmo "true" nunca excede automaticamente: sempre exige decisão humana.
ALLOW_OVER_BUDGET=false
# Lote 5.5: false (padrão) = fluxo REAL-only; nenhuma etapa cai em MOCK. true só em dev/teste deliberado.
ALLOW_MOCKS=false

# Máximo de tentativas (geração + regenerações) por cena. Evita loops de custo.
MAX_ATTEMPTS_PER_SCENE=3

# Lote 5: opt-in. Reinicie o servidor e crie NOVA campanha para estimativa/aprovação Runway.
# VIDEO_PROVIDER=runway  (padrão continua mock)
RUNWAYML_API_SECRET=
VIDEOS_DIR=outputs/videos
# Validação manual: npm run video:real -- --image "C:/fotos/produto.jpg"
# Sem --confirm: custo zero, não escreve arquivos. --confirm autoriza UMA geração paga de 5s.


# Lote 5.3 — AI UGC (somente MOCK por enquanto; provider real ainda não configurado)
UGC_DIR=outputs/ugc
# Estratégia de áudio do mock UGC: native_speech (vídeo fala) | external_lipsync (ElevenLabs + lip-sync)
UGC_MOCK_AUDIO_STRATEGY=native_speech
# AI UGC REAL (Lote 5.4) — DESLIGADO por padrão. A chave sozinha NÃO habilita: exige os três abaixo.
# GOOGLE_AI_API_KEY só no servidor (.env.local); nunca logada, serializada ou enviada ao browser.
GOOGLE_AI_API_KEY=
UGC_PROVIDER=mock
UGC_REAL_ALLOWED=false
UGC_REFERENCE_MODEL=gemini-3.1-flash-image
UGC_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Alternativa: UGC_PROVIDER=krea (Nano Banana 2 + Veo 3.1 Fast via Krea API). Mesmo opt-in UGC_REAL_ALLOWED=true.
# KREA_API_KEY só no servidor (.env.local); nunca logada, serializada ou enviada ao browser.
KREA_API_KEY=
