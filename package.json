{
  "name": "tiktok-ai-creative-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:cloud",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "plan:real": "tsx scripts/plan-real.ts",
    "test:render": "vitest run --config vitest.render.config.ts",
    "render:setup": "tsx scripts/render-setup.ts",
    "render:check": "tsx scripts/render-check.ts",
    "tts:real": "tsx scripts/tts-real.ts",
    "video:real": "tsx scripts/video-real.ts",
    "presenter:real": "tsx scripts/presenter-real.ts",
    "ugc:reference:real": "tsx scripts/ugc-reference-real.ts",
    "ugc:video:real": "tsx scripts/ugc-video-real.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:cloud": "vitest run --config vitest.cloud.config.ts",
    "start:api": "tsx src/cloud/api/main.ts",
    "dev:api": "tsx watch src/cloud/api/main.ts",
    "worker": "tsx src/cloud/worker/main.ts",
    "dev:worker": "tsx watch src/cloud/worker/main.ts",
    "worker:check": "tsx src/cloud/worker/main.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/bundler": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.531",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
